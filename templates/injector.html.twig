<script src="{{ asset('assets/dragsort/sortable.1.15.7.min.js', 'public') }}"></script>
<style>
    .listing__records .listing--container .listing--checkbox {
        cursor: grab;
    }
    .listing__records .listing--container .listing--checkbox:active {
        cursor: move;
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var firstRecord = document.querySelector('.listing__records .listing--container');
        var el = firstRecord ? firstRecord.parentElement : null;
        if (!el) {
            return;
        }

        var records = el.querySelectorAll('.listing--container');

        for (var i = 0; i < records.length; i++) {
            var checkbox = records[i].querySelector('.form-check-input');
            if (!checkbox) {
                continue;
            }

            var checkboxId = checkbox.getAttribute('id');
            if (!checkboxId) {
                continue;
            }

            var recordID = checkboxId.replace('row-', '');
            records[i].dataset.id = recordID;
        }

        var sortable = Sortable.create(el, {
            animation: 150,
            handle: '.listing--checkbox',
            draggable: '.listing--container'
        });

        sortable.option("onUpdate", function(event) {

            var formData = new URLSearchParams();
            formData.append('contentType', '{{ options.contentType }}');
            formData.append('page', '{{ options.page }}');
            formData.append('perPage', '{{ options.perPage|default(20) }}');

            var orderArray = sortable.toArray();
            for (var i = 0; i < orderArray.length; i++) {
                formData.append('order[]', orderArray[i]);
            }

            var headers = {
                'X-Requested-With': 'XMLHttpRequest'
            };

            var csrfToken = document.querySelector('meta[name="csrf-token"]');
            if (csrfToken) {
                headers['X-CSRF-TOKEN'] = csrfToken.getAttribute('content');
            }

            fetch('{{ path('dragsort_sort', parameters = [], relative = false) }}', {
                method: 'POST',
                headers: headers,
                body: formData
            })
            .then(function(response) {
                if (!response.ok) {
                    throw new Error('HTTP error ' + response.status);
                }
                return response.json();
            })
            .then(function() {
                // TODO
            })
            .catch(function(error) {
                console.error('Error:', error);
            });
        });
    });
</script>